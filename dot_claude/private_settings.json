{
  "cleanupPeriodDays": 30,
  "env": {
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1"
  },
  "permissions": {
    "allow": [
      "Bash(pip list *)",
      "Bash(cargo install *)",
      "Bash(wait)",
      "Bash(npm info *)",
      "Bash(python3 -m json.tool)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)"
    ],
    "defaultMode": "plan",
    "additionalDirectories": [
      "/Users/royng/.claude"
    ]
  },
  "skillOverrides": {},
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/comment-style.py\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking comment style"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session-source-log.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/work-note-gate.py\" 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Checking work note"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": false,
  "statusLine": {
    "type": "command",
    "command": "bash \"/Users/royng/.claude/hooks/statusline.sh\""
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "high",
  "autoCompactWindow": 500000,
  "awaySummaryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "preferredNotifChannel": "terminal_bell",
  "showTurnDuration": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",

      "**Internal sharing / snippet hosting**: None configured \u2014 treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: Default branch is `master` (from repo facts); protection/rulesets not queryable here (gh check did not run against this host)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",


      "**Trusted cloud buckets**: None configured",



      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (no prod-named hosts or namespaces observed in this repo's evidence)",

      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",


      "**Org-specific CLIs**: None configured (chezmoi, cmux, hs, sonar, venv, osascript seen locally but are personal/dev tooling, not org-specific)",

    ]
  }
}
