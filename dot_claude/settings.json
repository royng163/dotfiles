{
  "env": {
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1"
  },
  "permissions": {
    "allow": [
      "Bash(pip list *)",
      "Bash(cargo install *)",
      "Bash(wait)",
      "Bash(npm info *)",
      "Bash(python3 -m json.tool)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)"
    ],
    "defaultMode": "plan",
    "additionalDirectories": [
      "/Users/royng/.claude"
    ]
  },
  "model": "claude-fable-5[1m]",
  "skillOverrides": {},
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/comment-style.py\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking comment style"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session-source-log.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/work-note-gate.py\" 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Checking work note"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"/Users/royng/.claude/hooks/statusline.sh\""
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "preferredNotifChannel": "terminal_bell",
  "showTurnDuration": true
}
