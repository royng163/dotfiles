# cmux/Ghostty terminal appearance.
theme = One Dark Two
clipboard-read = allow
window-save-state = always

# Nerd Font: the prompt and file listings draw glyphs outside the base unicode set.
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 13
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
