[settings]
api_key = {{ .wakatimeApiKey }}
# Claude's scratch, plans, memory and session entries are logged as AI Coding but aren't work.
exclude =
    /\.notes/
{{- if hasKey . "wakatimeExclude" }}{{ range .wakatimeExclude }}
    {{ . }}
{{- end }}{{ end }}
    ^/private/tmp/
    ^/tmp/
    /\.claude/
    /Downloads/
    ^Claude [0-9a-f-]+$
