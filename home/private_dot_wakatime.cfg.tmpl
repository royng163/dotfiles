[settings]
api_key = {{ .wakatimeApiKey }}
# Agent scratch files, plans and session entries are not project work.
exclude =
    /\.notes/
{{- if hasKey . "wakatimeExclude" }}{{ range .wakatimeExclude }}
    {{ . }}
{{- end }}{{ end }}
    ^/private/tmp/
    ^/tmp/
    /\.claude/
    /\.codex/
    /\.agents/
    /Downloads/
    ^Claude [0-9a-f-]+$
