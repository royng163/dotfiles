# cmux/Ghostty terminal appearance.
# One Dark Pro Darker, as the 16 ANSI colors so the Starship prompt and
# Claude Code's dark-ansi theme both render from this one palette.
background = #23272e
foreground = #abb2bf
palette = 0=#3f4451
palette = 1=#e05561
palette = 2=#8cc265
palette = 3=#d18f52
palette = 4=#4aa5f0
palette = 5=#c162de
palette = 6=#42b3c2
palette = 7=#d7dae0
palette = 8=#4f5666
palette = 9=#ff616e
palette = 10=#a5e075
palette = 11=#f0a45d
palette = 12=#4dc4ff
palette = 13=#de73ff
palette = 14=#4cd1e0
palette = 15=#e6e6e6
background-blur = true
clipboard-read = allow
window-save-state = always

# Nerd Font: the prompt and file listings draw glyphs outside the base unicode set.
font-family = "Cascadia Mono NF"
font-thicken = true
# Floor every fg/bg pair at WCAG AA; dim greys get lifted, bright text is untouched.
minimum-contrast = 4.5
font-size = 13
window-padding-x = 8
window-padding-y = 2
window-padding-balance = true

# Wallpaper behind the text; minimum-contrast keeps foreground legible over the bright top.
background-image = /Users/royng/Documents/wallpaper/p3r_bg.jpeg
background-image-fit = cover
background-image-opacity = 0.04
