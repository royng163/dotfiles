// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "preview_tabs": {
    "enable_preview_from_file_finder": false
  },
  "debugger": {
    "dock": "right"
  },
  "diff_view_style": "split",
  "proxy": "",
  "agent_buffer_font_size": 15.0,
  "languages": {
    // SonarLint is kept for Python only: the Django repo is 612 .py / 0 .js, the
    // Vue repos the reverse, and each analyser costs ~500-950 MB of JVM.
    "Nginx": {
      "enable_language_server": false
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      },
      "language_servers": ["!sonarlint", "..."]
    },
    "TypeScript": { "language_servers": ["!sonarlint", "..."] },
    "TSX": { "language_servers": ["!sonarlint", "..."] },
    "HTML": { "language_servers": ["!sonarlint", "..."] },
    "CSS": { "language_servers": ["!sonarlint", "..."] },
    "YAML": { "language_servers": ["!sonarlint", "..."] },
    "Python": {
      "language_servers": ["pylsp", "!basedpyright"],
    },
  },
  "lsp": {
    "vtsls": {
      "settings": {
        // Zed defaults tsserver to 8 GiB, which two servers can exhaust on a
        // 16 GB machine. The semantic server peaks near 2.3 GB across these
        // repos, so 4 GiB clears the V8 heap limit without inviting swap.
        "typescript": { "tsserver": { "maxTsServerMemory": 4096 } },
        "javascript": { "tsserver": { "maxTsServerMemory": 4096 } }
      }
    },
    "wakatime": {
      "initialization_options": {
        "api-key": "{{ .wakatimeApiKey }}"
      }
    },
    "pylsp": {
      "settings": {
        "plugins": {
          "pycodestyle": { "enabled": false },
          "pyflakes": { "enabled": false },
          "mccabe": { "enabled": false },
          "rope_autoimport": { "enabled": true }
        },
      },
    },
{{- if hasKey . "sonarqubeUrl" }}
    "sonarlint": {
      "settings": {
        "connectedMode": {
          "connections": {
            "sonarqube": [
              {
                "connectionId": {{ .sonarqubeConnectionId | quote }},
                "serverUrl": {{ .sonarqubeUrl | quote }},
                "token": "{{ .sonarqubeToken }}"
              }
            ]
          }
        }
      }
    },
{{- end }}
  },
  "restore_on_startup": "last_session",
  "soft_wrap": "none",
  "preferred_line_length": 120,
  "git_panel": {
    "group_by": "staging",
    "sort_by": "path",
    "entry_primary_click_action": "project_diff",
    "tree_view": false,
    "collapse_untracked_diff": false,
    "status_style": "label_color",
    "show_count_badge": true,
    "file_icons": true,
  },
  "ensure_final_newline_on_save": false,
  "markdown_preview": {
    "limit_content_width": true,
  },
  "code_lens": "on",
  "git": {
    "inline_blame": {
      "show_commit_summary": true,
    },
  },
  "calls": {
    "mute_on_join": false,
  },
  "terminal": {
    "show_count_badge": false,
    "font_size": 13.0,
  },
  "project_panel": {
    "diagnostic_badges": true,
    "git_status_indicator": true,
  },
  "tabs": {
    "git_status": false,
    "file_icons": true,
  },
  "title_bar": {
    "show_menus": false,
    "show_branch_status_icon": false,
  },
  "status_bar": {
    "show_active_file": false,
    "line_endings_button": false,
    "active_language_button": true,
  },
  "prettier": {
    "allowed": true,
  },
  "inlay_hints": {
    "show_parameter_hints": true,
    "show_value_hints": true,
    "show_type_hints": false,
    "show_other_hints": true,
    "show_background": false,
    "enabled": true,
  },
  "toolbar": {
    "code_actions": false,
  },
  "agent_ui_font_size": 16.0,
  "buffer_line_height": "comfortable",
  "diagnostics": {
    "button": true,
    "inline": {
      "enabled": true,
    },
  },
  "language_models": {
    "opencode": {
      "show_go_models": false,
    },
  },
  "edit_predictions": {
    "open_ai_compatible_api": {
      "api_url": ""
    },
    "codestral": {
      "api_url": "https://codestral.mistral.ai"
    },
    "provider": "copilot",
    "allow_data_collection": "no",
  },
  "agent": {
    "terminal_init_command": "{{ if hasKey . "zedProxy" }}HTTPS_PROXY={{ .zedProxy }} HTTP_PROXY={{ .zedProxy }} {{ end }}claude",
    "enable_feedback": false,
    "expand_terminal_card": false,
    "max_content_width": 850.0,
    "limit_content_width": true,
    "flexible": true,
    "show_turn_stats": true,
    "single_file_review": true,
    "dock": "right",
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": [],
    "thinking_display": "preview",
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "plan"
      },
      "type": "registry",
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "base_keymap": "VSCode",
  "mouse_wheel_zoom": true,
  "minimap": {
    "show": "never",
  },
  "autosave": "off",
  "show_whitespaces": "all",
  "icon_theme": "Material Icon Theme",
  "auto_install_extensions": {
    "one-dark-pro": true,
    "material-icon-theme": true,
  },
  "ui_font_size": 16.0,
  "buffer_font_size": 14.0,
  // The one-dark-pro extension ships only "One Dark Pro", already on the Darker backgrounds;
  // these overrides take the remaining colors from VS Code's One Dark Pro Darker.
  "theme": "One Dark Pro",
  "theme_overrides": {
    "One Dark Pro": {
      "panel.background": "#1e2227",
      "editor.invisible": "#ffffff1d",
      "hint": "#abb2bf",
      "hint.background": "#2c313c",
      "version_control.added": "#109868",
      "version_control.modified": "#948b60",
      "version_control.deleted": "#9a353d",
      "players": [
        {
          "cursor": "#528bff",
          "background": "#528bff",
          "selection": "#67769660"
        }
      ],
      "syntax": {
        "comment": {
          "color": "#7f848eff"
        },
        "operator": {
          "color": "#56b6c2ff"
        },
        "string.regex": {
          "color": "#56b6c2ff"
        },
        "title": {
          "color": "#e06c75ff"
        },
        "punctuation.list_marker": {
          "color": "#e5c07bff"
        },
        "comment.doc": {
          "color": "#7f848eff"
        },
        "constant.comment.todo": {
          "color": "#61afefff",
          "background_color": "#61afef33",
          "font_weight": 700
        },
        "constant.comment.todo.text": {
          "color": "#61afefff",
          "background_color": "#61afef33",
          "font_weight": 400
        },
        "string.comment.info": {
          "color": "#98c379ff",
          "background_color": "#98c37933",
          "font_weight": 700
        },
        "string.comment.info.text": {
          "color": "#98c379ff",
          "background_color": "#98c37933",
          "font_weight": 400
        },
        "keyword.comment.warn": {
          "color": "#e5c07bff",
          "background_color": "#e5c07b33",
          "font_weight": 700
        },
        "keyword.comment.warn.text": {
          "color": "#e5c07bff",
          "background_color": "#e5c07b33",
          "font_weight": 400
        },
        "property.comment.error": {
          "color": "#e06c75ff",
          "background_color": "#e06c7533",
          "font_weight": 700
        },
        "property.comment.error.text": {
          "color": "#e06c75ff",
          "background_color": "#e06c7533",
          "font_weight": 400
        },
      },
    },
  },
  "log": {
    "dev_container": "trace",
    "remote": "trace",
    "terminal": "trace",
  },
}
