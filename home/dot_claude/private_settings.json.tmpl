{{- $home := .chezmoi.homeDir | replace "\\" "/" -}}
{
  "cleanupPeriodDays": 30,
  "env": {
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_EFFORT_LEVEL": "high",
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1"
{{- /* proxy is per-machine data from ~/.config/chezmoi/chezmoi.toml, never committed */}}
{{- if hasKey . "proxy" }},
    "HTTP_PROXY": {{ .proxy | quote }},
    "HTTPS_PROXY": {{ .proxy | quote }}
{{- end }}
  },
  "permissions": {
    "allow": [
      "Bash(pip list *)",
      "Bash(cargo install *)",
      "Bash(wait)",
      "Bash(npm info *)",
      "Bash(python3 -m json.tool)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git commit)",
      "Bash(git commit *)"
    ],
    "defaultMode": "plan",
    "additionalDirectories": [
      "{{ $home }}/.claude"
    ]
  },
  "skillOverrides": {},
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/comment-style.py\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking comment style"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session-source-log.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/work-note-gate.py\" 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Checking work note"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": false,
  "statusLine": {
    "type": "command",
    "command": "bash \"{{ $home }}/.claude/hooks/statusline.sh\""
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "high",
  "autoCompactWindow": 500000,
  "awaySummaryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:blue-prompt",
  "preferredNotifChannel": "terminal_bell",
  "showTurnDuration": true
{{- /* work-specific autoMode context is per-machine data, never committed */}}
{{- if hasKey . "claudeAutoModeEnvironment" }},
  "autoMode": {
    "environment": {{ .claudeAutoModeEnvironment | toPrettyJson }}
  }
{{- end }}
}
