
# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$("$HOME/miniforge3/bin/conda" 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "$HOME/miniforge3/etc/profile.d/conda.sh" ]; then
        . "$HOME/miniforge3/etc/profile.d/conda.sh"
    else
        export PATH="$HOME/miniforge3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<


# >>> mamba initialize >>>
# !! Contents within this block are managed by 'mamba shell init' !!
export MAMBA_EXE="$HOME/miniforge3/bin/mamba"
export MAMBA_ROOT_PREFIX="$HOME/miniforge3"
__mamba_setup="$("$MAMBA_EXE" shell hook --shell zsh --root-prefix "$MAMBA_ROOT_PREFIX" 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__mamba_setup"
else
    alias mamba="$MAMBA_EXE"  # Fallback on help from mamba activate
fi
unset __mamba_setup
# <<< mamba initialize <<<

# opencode
export PATH=$HOME/.opencode/bin:$PATH

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
{{ if eq .chezmoi.os "darwin" -}}
alias code="open -a \"Visual Studio Code\""
export DYLD_LIBRARY_PATH=/opt/homebrew/lib:$DYLD_LIBRARY_PATH
{{- end }}

# mimocode
export PATH=$HOME/.mimocode/bin:$PATH

# Editor for Vue DevTools "open in editor". Vite 4 bundles a launch-editor with no
# zed entry, and its fallthrough passes the line and column as separate arguments,
# which Zed opens as extra files named after the numbers. "subl" is in its table and
# gets a single path:line:column, which the Zed CLI accepts. ~/.local/bin/subl -> zed.
export LAUNCH_EDITOR="$HOME/.local/bin/subl"

# Prompt. Must load after conda/mamba init, which rewrite PS1.
eval "$(starship init zsh)"

# Modern CLI tools. Each is guarded so this file still loads on a machine or OS
# where the binary is absent.
# --cmd cd makes cd itself do the frecency jump; cdi is the fzf picker.
command -v zoxide >/dev/null && eval "$(zoxide init zsh --cmd cd)"

# Debian and Ubuntu ship bat as batcat to avoid a name clash with bacula-console.
command -v batcat >/dev/null && ! command -v bat >/dev/null && alias bat=batcat

if command -v eza >/dev/null; then
  alias ls='eza --icons --group-directories-first'
  alias ll='eza -l --icons --group-directories-first --git'
  alias la='eza -la --icons --group-directories-first --git'
  alias lt='eza --tree --level=2 --icons'
fi

# Tab completion. Made explicit here rather than relying on bun's completion file
# to bootstrap it, which is where compinit was being loaded from.
autoload -Uz compinit && compinit

# Suggestion and highlighting plugins, from the first prefix that has them.
# Syntax highlighting wraps the line editor, so it must stay last in this file.
for _d in /opt/homebrew/share /usr/share/zsh/plugins /usr/share; do
  [ -r "$_d/zsh-autosuggestions/zsh-autosuggestions.zsh" ] &&
    source "$_d/zsh-autosuggestions/zsh-autosuggestions.zsh" && break
done
for _d in /opt/homebrew/share /usr/share/zsh/plugins /usr/share; do
  [ -r "$_d/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] &&
    source "$_d/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" && break
done
unset _d
